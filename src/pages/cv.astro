---
import Base from '../layouts/Base.astro';
---

<Base
  title="CV · Felipe Aguilera"
  description="Brand and communication strategist. Curriculum Vitae."
  lang="en"
>
  <div class="topbar"></div>

  <nav>
    <div class="wrap nav-in">
      <a class="logo" href="/">
        <img src="/assets/mark-seal.svg" alt="FA seal" />
        <span class="name">Felipe Aguilera</span>
      </a>
      <div class="nav-links">
        <a href="/#notebook">Notebook</a>
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/cv" style="color:var(--ink);">CV</a>
        <span class="lang">
          <a href="/cv" class="active">EN</a>/<a href="/cv-es">ES</a>
        </span>
        <a href="/#hello" class="nav-cta">Work together</a>
      </div>
    </div>
  </nav>

  <!-- CV HEADER -->
  <div class="cv-header">
    <div class="wrap narrow">
      <div class="eyebrow">Curriculum Vitae</div>
      <h1 class="cv-name">Felipe Aguilera</h1>
      <p class="cv-title">Brand and communication strategist.</p>
      <div class="cv-contact">
        <span>Santiago, Chile</span>
        <span>Remote · Open to global</span>
        <a href="mailto:felipe@faguilera.com">felipe@faguilera.com</a>
        <a href="https://faguilera.com" target="_blank">faguilera.com</a>
        <a href="https://evo.cl" target="_blank">evo.cl</a>
        <a href="https://linkedin.com/in/felipeaguilera" target="_blank">LinkedIn</a>
      </div>
      <div class="cv-actions">
        <button class="btn primary" onclick="window.print()">Print this page</button>
        <a class="btn ghost" href="/#work">See portfolio</a>
      </div>

      <div class="cv-downloads">
        <div class="dl-label">Targeted versions</div>
        <div class="dl-links">
          <a href="/assets/cv/faguilera-cv-en-marketing.pdf" download>Marketing Strategist (EN) ↓</a>
          <span class="dl-sep">·</span>
          <a href="/assets/cv/faguilera-cv-es-marketing.pdf" download>Estratega de Marketing (ES) ↓</a>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap header-orn">
    <div class="fleuron"><span>&#10086;</span></div>
  </div>

  <!-- CV BODY -->
  <div class="cv-body">
    <div class="wrap narrow">

      <!-- EXPERIENCE -->
      <div class="cv-section">
        <div class="eyebrow">Experience</div>

        <div class="exp-block">
          <div class="exp-meta">
            <span class="exp-dates">2024 — Present</span>
            <span class="exp-org">EVO Creative Lab<br />Santiago · Remote</span>
          </div>
          <div class="exp-content">
            <div class="exp-role">Founder &amp; Creative Consultant</div>
            <div class="exp-body">
              <ul>
                <li>Brand strategy, identity systems, and communication design for clients across industrial, retail, mining, editorial, and financial sectors.</li>
                <li>CRM and email marketing programs built and operated via Brevo: automation flows, segmentation, and performance reporting.</li>
                <li>Web properties managed on WordPress/WooCommerce and static stacks: content calendars, SEO structure, and social workflows.</li>
                <li>Active clients: DGC Maquinarias, Acción Vintage, María Paz Jiménez, Saldipe, Alejandro Sagner SpA, Schiff Sovereign.</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="exp-block">
          <div class="exp-meta">
            <span class="exp-dates">2013 — 2024</span>
            <span class="exp-org">Zmart Games<br />Santiago, Chile</span>
          </div>
          <div class="exp-content">
            <div class="exp-role">Marketing Manager &amp; UX Director</div>
            <div class="exp-body">
              <p>A decade leading marketing, brand, and customer experience for Chile's leading gaming and geek retail chain.</p>
              <ul>
                <li>Built and scaled zmart.cl into a 100k+ product omnichannel platform, directing UX, digital content, and platform operations.</li>
                <li>Deployed a 4K dynamic content system synced across 25+ retail locations nationwide.</li>
                <li>Founded and edited Inzider Magazine: a free print magazine sustained by publisher advertising (Nintendo, PlayStation, Xbox, Pokémon, Magic: The Gathering), multiple editions over several years.</li>
                <li>Led culture and internal communication work recognized with a Great Place to Work certification.</li>
              </ul>
            </div>
            <span class="exp-note">Brand · CRM · E-commerce · Editorial · Retail rollout · UX direction</span>
          </div>
        </div>

        <div class="exp-block">
          <div class="exp-meta">
            <span class="exp-dates">Mar 2024 — May 2025</span>
            <span class="exp-org">Digno<br />Santiago · Concurrent</span>
          </div>
          <div class="exp-content">
            <div class="exp-role">Senior Digital Strategy &amp; Client Management</div>
            <div class="exp-body">
              <ul>
                <li>Strategic consulting across industries: digital transformation, brand and identity alignment, UX advisory.</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="exp-block">
          <div class="exp-meta">
            <span class="exp-dates">2005 — 2013</span>
            <span class="exp-org">Elemento Media Design<br />Santiago, Chile</span>
          </div>
          <div class="exp-content">
            <div class="exp-role">Head of Digital Projects</div>
            <div class="exp-body">
              <ul>
                <li>Led digital project delivery for Metro de Santiago, Tetra Pak, Suzuki, Sodimac, and Codelco: brand sites, intranets, and digital campaigns.</li>
                <li>Managed cross-functional teams and client relationships across multiple concurrent enterprise projects.</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="exp-block">
          <div class="exp-meta">
            <span class="exp-dates">1998 — 2005</span>
            <span class="exp-org">Entel · Lan-Z.net<br />VEEgroup · Intelec</span>
          </div>
          <div class="exp-content">
            <div class="exp-role">Early Career: Design, Digital &amp; Brand</div>
            <div class="exp-body">
              <ul>
                <li>Multimedia and brand design for Entel's broadband and family portals.</li>
                <li>Brand content, newsletters, and radio production for Chile's leading gamer community (Lan-Z.net).</li>
                <li>Web and digital solutions for law firms, NGOs, and cultural organizations (VEEgroup).</li>
                <li>Data visualization for Movistar network expansion reports (Intelec).</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- SUPPLEMENT GRID: Education + Skills + Certs -->
    <div style="background:var(--cream);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:24px;">
      <div class="wrap narrow">
        <div class="supplement-grid">

          <div class="supp-col">
            <div class="eyebrow">Education</div>
            <div class="supp-item">
              Diseñador Gráfico Profesional
              <span class="sub">Duoc UC · 2000 – 2004</span>
            </div>
            <div class="eyebrow" style="margin-top:28px;">Certifications</div>
            <div class="supp-item">Google UX Design Professional Certificate</div>
            <div class="supp-item">Google Digital Marketing &amp; E-commerce</div>
            <div class="supp-item">Google Project Management Fundamentals</div>
            <div class="supp-item">Google AI Essentials</div>
          </div>

          <div class="supp-col">
            <div class="eyebrow">Skills</div>
            <div class="skill-wrap">
              <span class="skill-pill">Brand Strategy</span>
              <span class="skill-pill">Brand Identity</span>
              <span class="skill-pill">Positioning</span>
              <span class="skill-pill">Brand Voice</span>
              <span class="skill-pill">Content Strategy</span>
              <span class="skill-pill">Copywriting EN/ES</span>
              <span class="skill-pill">Editorial Direction</span>
              <span class="skill-pill">Campaign Planning</span>
              <span class="skill-pill">Email Marketing</span>
              <span class="skill-pill">CRM</span>
              <span class="skill-pill">E-commerce</span>
              <span class="skill-pill">UX Direction</span>
              <span class="skill-pill">Social Media</span>
              <span class="skill-pill">Marketing Ops</span>
            </div>
          </div>

          <div class="supp-col">
            <div class="eyebrow">Tools</div>
            <div class="skill-wrap">
              <span class="skill-pill">Figma</span>
              <span class="skill-pill">Affinity Publisher</span>
              <span class="skill-pill">Brevo</span>
              <span class="skill-pill">Notion</span>
              <span class="skill-pill">WordPress</span>
              <span class="skill-pill">WooCommerce</span>
              <span class="skill-pill">CapCut</span>
              <span class="skill-pill">Substack</span>
              <span class="skill-pill">Claude / AI tools</span>
            </div>
            <div class="eyebrow" style="margin-top:28px;">Languages</div>
            <div class="supp-item">
              Spanish
              <span class="sub">Native</span>
            </div>
            <div class="supp-item">
              English
              <span class="sub">Professional proficiency</span>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- TAGLINE -->
    <div class="wrap narrow">
      <div class="cv-tagline">
        <p>"Strategy and hands-on execution. I work best when I own the outcome, not just the brief."</p>
        <a class="textlink" href="/#hello">Get in touch →</a>
      </div>
      <div class="header-orn" style="padding:36px 0 0;">
        <div class="fleuron"><span>&#10086;</span></div>
      </div>
    </div>

  </div><!-- /.cv-body -->

  <footer>
    <div class="wrap">
      <div class="foot-orn">&#10086;</div>
      <div class="foot-in">
        <div>
          <a class="logo" href="/">
            <img src="/assets/mark-seal-white.svg" alt="FA seal" />
            <span class="name">Felipe Aguilera</span>
          </a>
          <p class="foot-tag">Strategist by trade, curious by nature. Santiago, Chile.</p>
        </div>
        <div class="foot-links">
          <a href="/cv">CV</a>
          <a href="https://www.linkedin.com/in/felipeaguilera" target="_blank">LinkedIn</a>
          <a href="https://felipeaguilera.substack.com" target="_blank">Substack</a>
          <a href="mailto:felipe@faguilera.com">Email</a>
        </div>
      </div>
      <div class="foot-copy">&copy; 2026 Felipe Aguilera &middot; faguilera.com</div>
    </div>
  </footer>
</Base>
