---
import Base from '../layouts/Base.astro';
---

<Base
  title="CV · Felipe Aguilera · Graphic Designer"
  description="Graphic Designer. Brand, Retail & Commercial Material. Curriculum Vitae."
  lang="en"
>
  <div class="topbar"></div>

  <nav>
    <div class="wrap nav-in">
      <a class="logo" href="/">
        <img src="/assets/mark-seal.svg" alt="FA seal" />
        <span class="name">Felipe Aguilera</span>
      </a>
      <div class="nav-links">
        <a href="/#notebook">Notebook</a>
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/cv" style="color:var(--ink);">CV</a>
        <span class="lang">
          <a href="/cv" class="active">EN</a>/<a href="/cv-es">ES</a>
        </span>
        <a href="/#hello" class="nav-cta">Work together</a>
      </div>
    </div>
  </nav>

  <!-- CV HEADER -->
  <div class="cv-header">
    <div class="wrap narrow">
      <div class="eyebrow">Curriculum Vitae</div>
      <h1 class="cv-name">Felipe Aguilera</h1>
      <p class="cv-title">Graphic Designer. Brand, Retail &amp; Commercial Material.</p>
      <div class="cv-contact">
        <span>Santiago, Chile</span>
        <span>+56 9 8239 3697</span>
        <a href="mailto:felipe@faguilera.com">felipe@faguilera.com</a>
        <a href="https://faguilera.com" target="_blank">faguilera.com</a>
        <a href="https://evo.cl" target="_blank">evo.cl</a>
        <a href="https://linkedin.com/in/felipeaguilera" target="_blank">LinkedIn</a>
      </div>
      <div class="cv-actions">
        <button class="btn primary" onclick="window.print()">Print this page</button>
        <a class="btn ghost" href="/assets/cv/faguilera-cv-en.pdf" download>Download PDF ↓</a>
      </div>

      <div class="cv-downloads">
        <div class="dl-label">Direct PDF download</div>
        <div class="dl-links">
          <a href="/assets/cv/faguilera-cv-en.pdf" download>English Version (PDF) ↓</a>
          <span class="dl-sep">·</span>
          <a href="/assets/cv/faguilera-cv-es.pdf" download>Versión en Español (PDF) ↓</a>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap header-orn">
    <div class="fleuron"><span>&#10086;</span></div>
  </div>

  <!-- CV BODY -->
  <div class="cv-body">
    <div class="wrap narrow">

      <!-- PROFILE -->
      <div class="cv-section" style="padding-top:0;">
        <div class="eyebrow">Profile</div>
        <p style="font-size:18px; line-height:1.75; color:var(--ink);">
          Graphic Designer from Duoc UC. For ten years, I directed brand, marketing, and retail design at Zmart, Chile's leading gaming retail chain, with over 25 stores and the local rollout of brand guidelines for PlayStation, Nintendo, Xbox, and Pokémon. I manage the full cycle: digital and social assets, technical datasheets and catalogs, POP material and merchandising, print-ready files, and supplier coordination. Since 2024, I operate independently with clients across Chile, Peru, and Europe.
        </p>
      </div>

      <!-- EXPERIENCE -->
      <div class="cv-section">
        <div class="eyebrow">Experience</div>

        <div class="exp-block">
          <div class="exp-meta">
            <span class="exp-dates">2024 — Present</span>
            <span class="exp-org">EVO Communication Lab<br />(EVO SpA)<br />Santiago · Remote</span>
          </div>
          <div class="exp-content">
            <div class="exp-role">Founder &amp; Brand &amp; Communication Consultant</div>
            <div class="exp-body">
              <ul>
                <li>Identity systems and brand kits for industrial and consumer clients: DGC Maquinarias, Saldipe Ingeniería, Alejandro Sagner SpA, Croq' Délice, Eko3.</li>
                <li>Continuous graphic production: product datasheets, catalogs, banners, campaign assets, signage, and booth materials for mining and industrial trade shows.</li>
                <li>Visual content for e-commerce and social media: catalog imagery, product visuals, and publishing schedules with clear brand criteria.</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="exp-block">
          <div class="exp-meta">
            <span class="exp-dates">2013 — 2024</span>
            <span class="exp-org">Zmart Games<br />Santiago, Chile</span>
          </div>
          <div class="exp-content">
            <div class="exp-role">Marketing Manager &amp; UX Director</div>
            <div class="exp-body">
              <ul>
                <li>Led the chain's visual identity and retail execution across 25+ mall and standalone stores: storefront displays, signage, promotional graphics, and POP collateral.</li>
                <li>Local execution of brand guidelines for PlayStation, Nintendo, Xbox, Pokémon, and Magic: The Gathering for product launches and seasonal campaigns.</li>
                <li>Design and maintenance of e-commerce visual content (100k+ products): product pages, banners, catalog images, and in-store promotional graphics.</li>
                <li>Dynamic 4K in-store screen content system synchronized with the retail sales platform.</li>
                <li>Founded and edited Inzider Magazine (2014–2019), a free print magazine funded by advertising from Nintendo, PlayStation, Xbox, and Pokémon. Art direction, layout, and prepress production.</li>
                <li>Product photography production and editing for catalogs, campaigns, and retail points of sale.</li>
                <li>Coordination with agencies, print houses, and rollout vendors with on-site supervision.</li>
              </ul>
            </div>
            <span class="exp-note">Brand · Retail design · E-commerce · Editorial · POP material · UX direction</span>
          </div>
        </div>

        <div class="exp-block">
          <div class="exp-meta">
            <span class="exp-dates">2005 — 2013</span>
            <span class="exp-org">Elemento Media Design<br />Santiago, Chile</span>
          </div>
          <div class="exp-content">
            <div class="exp-role">Head of Digital Projects</div>
            <div class="exp-body">
              <ul>
                <li>Website and intranet design for Metro de Santiago, Tetra Pak, Suzuki, Sodimac, Codelco, and ABB.</li>
                <li>Adaptation of corporate and international brand guidelines into digital assets and internal communications.</li>
                <li>Cross-functional coordination between design, development, and enterprise clients under strict deadlines.</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="exp-block">
          <div class="exp-meta">
            <span class="exp-dates">1998 — 2005</span>
            <span class="exp-org">Entel · Lan-Z.net<br />Intelec</span>
          </div>
          <div class="exp-content">
            <div class="exp-role">Early Career: Graphic Design, Digital &amp; Brand</div>
            <div class="exp-body">
              <ul>
                <li>Entel S.A., specialist graphic designer (consultant): multimedia experiences for broadband and family web portals.</li>
                <li>Lan-Z.net, creative director: UI design, newsletters, and brand content for Chile's leading gamer community.</li>
                <li>Intelec S.A., data visualization: interactive reporting tools for mobile network expansion engineering teams.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- SUPPLEMENT GRID -->
    <div style="background:var(--cream);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:36px;">
      <div class="wrap narrow">
        <div class="supplement-grid">

          <div class="supp-col">
            <div class="eyebrow">Education</div>
            <div class="supp-item">
              Professional Graphic Designer
              <span class="sub">Duoc UC · 2000 – 2004</span>
            </div>
            <div class="eyebrow" style="margin-top:28px;">Languages</div>
            <div class="supp-item">
              Spanish
              <span class="sub">Native</span>
            </div>
            <div class="supp-item">
              English
              <span class="sub">Advanced professional</span>
            </div>
          </div>

          <div class="supp-col">
            <div class="eyebrow">Tools</div>
            <div class="skill-wrap">
              <span class="skill-pill">Adobe Photoshop</span>
              <span class="skill-pill">Adobe Illustrator</span>
              <span class="skill-pill">Adobe InDesign</span>
              <span class="skill-pill">Affinity Publisher</span>
              <span class="skill-pill">Affinity Designer</span>
              <span class="skill-pill">Figma</span>
              <span class="skill-pill">CapCut</span>
              <span class="skill-pill">After Effects</span>
              <span class="skill-pill">WordPress</span>
              <span class="skill-pill">WooCommerce</span>
              <span class="skill-pill">Shopify</span>
              <span class="skill-pill">HTML &amp; CSS</span>
              <span class="skill-pill">Brevo</span>
            </div>
          </div>

          <div class="supp-col">
            <div class="eyebrow">Certifications</div>
            <div class="supp-item">Google UX Design Professional Certificate</div>
            <div class="supp-item">Google Project Management Fundamentals</div>
            <div class="supp-item">Google Digital Marketing &amp; E-commerce</div>
            <div class="supp-item">Google AI Essentials</div>
            <div class="eyebrow" style="margin-top:28px;">Capabilities</div>
            <div class="supp-item">
              Prepress &amp; Production
              <span class="sub">Print-ready files, color profiles, print house supervision</span>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- TAGLINE -->
    <div class="wrap narrow">
      <div class="cv-tagline">
        <p>"Design, strategy, and hands-on production. From brand conceptualization to final delivery in print or digital."</p>
        <a class="textlink" href="/#hello">Get in touch →</a>
      </div>
      <div class="header-orn" style="padding:36px 0 0;">
        <div class="fleuron"><span>&#10086;</span></div>
      </div>
    </div>

  </div>

  <footer>
    <div class="wrap">
      <div class="foot-orn">&#10086;</div>
      <div class="foot-in">
        <div>
          <a class="logo" href="/">
            <img src="/assets/mark-seal-white.svg" alt="FA seal" />
            <span class="name">Felipe Aguilera</span>
          </a>
          <p class="foot-tag">Graphic Designer. Brand, Retail &amp; Commercial Material. Santiago, Chile.</p>
        </div>
        <div class="foot-links">
          <a href="/cv">CV</a>
          <a href="https://www.linkedin.com/in/felipeaguilera" target="_blank">LinkedIn</a>
          <a href="https://felipeaguilera.substack.com" target="_blank">Substack</a>
          <a href="mailto:felipe@faguilera.com">Email</a>
        </div>
      </div>
      <div class="foot-copy">&copy; 2026 Felipe Aguilera &middot; faguilera.com</div>
    </div>
  </footer>
</Base>
